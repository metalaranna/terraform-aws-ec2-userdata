# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.
region    = "us-east-1"
name      = "app-server"
vpc_id    = "vpc-0123456789abcdef0"
subnet_id = "subnet-0123456789abcdef0"

# Your app's CIDR / your IP in CIDR form
allowed_cidr_blocks = ["10.0.0.0/16"]
app_port            = 8080

# Optional overrides
# instance_type = "t3.micro"
# packages      = ["git", "jq"]

# Example: run a container on boot. This whole string is appended to the
# generated user data script, after Docker and the CloudWatch Agent are set up.
app_user_data = <<-EOT
  docker run -d --restart unless-stopped -p 8080:8080 nginxdemos/hello
EOT

tags = {
  Environment = "dev"
}
